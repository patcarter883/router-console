{
	"router-console": {
		"description": "router-console native client: staged UCI editing across the core config domains plus the custom app plugin surfaces",
		"read": {
			"ubus": {
				"uci": [ "get", "state", "changes" ],
				"service": [ "list" ],
				"modemaim": [ "status", "origin", "bearing", "towers" ],
				"nettime": [ "status" ]
			},
			"uci": [ "system", "network", "wireless", "firewall", "dhcp", "sqm", "rist2rist", "modemaim" ]
		},
		"write": {
			"ubus": {
				"uci": [ "set", "add", "delete", "apply", "confirm", "revert", "commit", "order", "rename" ]
			},
			"uci": [ "system", "network", "wireless", "firewall", "dhcp", "sqm" ]
		}
	}
}
