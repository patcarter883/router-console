config rist2rist 'main'
	option enabled '1'
	option listen_url 'rist://@0.0.0.0:5000'
	option profile '2'
	option out_profile '2'
	option buffer_min '1000'
	option buffer_max '5000'
	option rtt_min '40'
	option rtt_max '500'
	option reorder_buffer '30'
	option telemetry_enabled '1'
	option telemetry_target '192.168.78.2:7000'

config destination 'wan_a'
	option address 'rist://203.0.113.10:6000'
	option interface 'wan'
	option weight '1'

config destination 'lan_probe'
	option address 'rist://192.168.78.50:6000'
	option interface 'lan2'
	option weight '2'
